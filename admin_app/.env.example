# AgriStore Admin App — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Run: flutter run -d chrome --dart-define-from-file=.env

SUPABASE_URL=

# New-style publishable key (sb_publishable_...) for projects created after Nov 2025:
SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key (eyJ...) for older Supabase projects:
SUPABASE_ANON_KEY=
